{
  "name": "repo",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "turbo run start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build:docker:api": "docker build -t tasky-api:latest -f apps/api/Dockerfile .",
    "build:docker:web": "docker build -t tasky-web:latest -f apps/web/Dockerfile ."
  },
  "devDependencies": {
    "turbo": "2.10.13",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.19.0"
  }
}
